{
  "name": "cnr-booking",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:files": "test -z \"$(git ls-files -d)\" || { echo '⛔ 로컬에서 삭제된 파일이 있습니다 (git checkout -- <파일> 로 복구):'; git ls-files -d; exit 1; }",
    "check": "npm run check:files && tsc --noEmit && vite build"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@supabase/supabase-js": "^2.39.0",
    "@xyflow/react": "^12.12.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.383.0",
    "material-symbols": "^0.44.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0"
  }
}
